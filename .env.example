# Required for Gemini models
GEMINI_API_KEY=your_gemini_api_key_here

# Required for writing threads into the save-data GitHub repo
# (Horizon can inject this as a secret)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides
# THREADFORGE_STORAGE_REPO=save-data
# THREADFORGE_STORAGE_ROOT=Chatbot MCP data
# MCP_TRANSPORT=stdio   # or streamable-http for Horizon
